<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host + HTTPS. GitHub Pages does not execute this file, but keeping
# the rule aligned prevents a future Apache/CDN migration from splitting URLs.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.betamakine\.com$ [NC]
RewriteRule ^ https://www.betamakine.com%{REQUEST_URI} [R=301,L]

# Normalize index URLs to directory canonical form
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[\s?]|$) [NC]
RewriteRule ^ https://www.betamakine.com/%1 [R=301,L,NE]
</IfModule>

ErrorDocument 404 /404.html
