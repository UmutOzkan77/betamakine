<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host + HTTPS
RewriteCond %{HTTP_HOST} ^www\.betamakine\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://betamakine.com%{REQUEST_URI} [R=301,L]

# Normalize index URLs to directory canonical form
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
